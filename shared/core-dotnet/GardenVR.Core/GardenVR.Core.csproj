<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity package's pure C# sources so the rules are tested without Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>GardenVR.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../packages/com.gardenvr.core/Runtime/**/*.cs" />
  </ItemGroup>
</Project>
